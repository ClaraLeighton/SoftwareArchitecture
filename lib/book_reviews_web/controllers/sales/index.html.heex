<h1 class="text-2xl font-bold mb-4">Sales by Year</h1>

<.link
  href={~p"/sales/new"}
  class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 mb-4 inline-block"
>
  New Sale Entry
</.link>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Book ID
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Year
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Sales
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Actions
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <%= for sale <- @sales do %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <.link
              href={~p"/books/#{id_to_string(sale["book_id"])}"}
              class="text-indigo-600 hover:text-indigo-900"
            >
              {id_to_string(sale["book_id"]) |> String.slice(0, 8)}...
            </.link>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {sale["year"]}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {format_number(sale["sales"])}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <.link
              href={~p"/sales/#{id_to_string(sale["_id"])}"}
              class="text-indigo-600 hover:text-indigo-900 mr-3"
            >Show</.link>
            <.link
              href={~p"/sales/#{id_to_string(sale["_id"])}/edit"}
              class="text-amber-600 hover:text-amber-900 mr-3"
            >Edit</.link>
            <.link
              href={~p"/sales/#{id_to_string(sale["_id"])}"}
              method="delete"
              data-confirm="Are you sure?"
              class="text-red-600 hover:text-red-900"
            >Delete</.link>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
