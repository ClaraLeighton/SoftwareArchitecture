<h1 class="text-2xl font-bold mb-4">Sale Details</h1>

<.link href={~p"/sales"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Sales</.link>

<div class="bg-white shadow rounded-lg p-6">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Book ID</dt>
      <dd class="mt-1 text-sm text-gray-900">
        <.link
          href={~p"/books/#{id_to_string(@sale["book_id"])}"}
          class="text-indigo-600 hover:text-indigo-900"
        >
          {id_to_string(@sale["book_id"])}
        </.link>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Year</dt>
      <dd class="mt-1 text-sm text-gray-900">{@sale["year"]}</dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Sales</dt>
      <dd class="mt-1 text-sm text-gray-900">{format_number(@sale["sales"])}</dd>
    </div>
  </dl>
</div>

<div class="mt-4 flex gap-2">
  <.link
    href={~p"/sales/#{id_to_string(@sale["_id"])}/edit"}
    class="bg-amber-500 text-white px-4 py-2 rounded hover:bg-amber-600"
  >Edit</.link>
  <.link
    href={~p"/sales/#{id_to_string(@sale["_id"])}"}
    method="delete"
    data-confirm="Are you sure?"
    class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700"
  >Delete</.link>
</div>
