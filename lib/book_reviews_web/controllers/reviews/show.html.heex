<h1 class="text-2xl font-bold mb-4">Review Details</h1>

<.link href={~p"/reviews"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Reviews</.link>

<div class="bg-white shadow rounded-lg p-6">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Book ID</dt>
      <dd class="mt-1 text-sm text-gray-900">
        <.link
          href={~p"/books/#{id_to_string(@review["book_id"])}"}
          class="text-indigo-600 hover:text-indigo-900"
        >
          {id_to_string(@review["book_id"])}
        </.link>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Score</dt>
      <dd class="mt-1 text-sm text-gray-900">
        <span class="text-yellow-500">{score_stars(@review["score"])}</span>
        <span class="ml-2">{@review["score"]}/5</span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Upvotes</dt>
      <dd class="mt-1 text-sm text-gray-900">{@review["upvotes"]}</dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-sm font-medium text-gray-500">Review</dt>
      <dd class="mt-1 text-sm text-gray-900">{@review["review"]}</dd>
    </div>
  </dl>
</div>

<div class="mt-4 flex gap-2">
  <.link
    href={~p"/reviews/#{id_to_string(@review["_id"])}/edit"}
    class="bg-amber-500 text-white px-4 py-2 rounded hover:bg-amber-600"
  >Edit</.link>
  <.link
    href={~p"/reviews/#{id_to_string(@review["_id"])}"}
    method="delete"
    data-confirm="Are you sure?"
    class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700"
  >Delete</.link>
</div>
