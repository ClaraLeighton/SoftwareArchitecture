<h1 class="text-2xl font-bold mb-4">Edit Author</h1>

<.link href={~p"/authors"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Authors</.link>

<.form
  for={%{}}
  action={~p"/authors/#{id_to_string(@author["_id"])}"}
  method="post"
  enctype="multipart/form-data"
  class="space-y-4"
>
  <input type="hidden" name="_method" value="put" />
  <div>
    <label class="block text-sm font-medium text-gray-700">Name</label>
    <input
      type="text"
      name="author[name]"
      value={@author["name"]}
      required
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Photo</label>
    <%= if @author["image"] do %>
      <div class="mt-2 flex items-center gap-3">
        <img
          src={@author["image"]}
          alt="Current photo"
          class="h-16 w-16 object-cover rounded-full"
        />
        <span class="text-xs text-gray-500">Current photo. Upload a new file to replace it.</span>
      </div>
    <% end %>
    <input
      type="file"
      name="author[image]"
      accept="image/*"
      class="mt-1 block w-full text-sm text-gray-700 file:mr-4 file:rounded file:border-0 file:bg-purple-50 file:py-2 file:px-4 file:text-purple-700"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
    <input
      type="date"
      name="author[date_of_birth]"
      value={format_date(@author["date_of_birth"])}
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Country</label>
    <input
      type="text"
      name="author[country]"
      value={@author["country"]}
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Bio</label>
    <textarea
      name="author[bio]"
      rows="3"
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    ><%= @author["bio"] %></textarea>
  </div>
  <div>
    <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">Update Author</button>
  </div>
</.form>
