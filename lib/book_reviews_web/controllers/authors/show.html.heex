<h1 class="text-2xl font-bold mb-4">Author Details</h1>

<.link href={~p"/authors"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Authors</.link>

<div class="bg-white shadow rounded-lg p-6">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="mt-1 text-sm text-gray-900">{@author["name"]}</dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Country</dt>
      <dd class="mt-1 text-sm text-gray-900">{@author["country"]}</dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Date of Birth</dt>
      <dd class="mt-1 text-sm text-gray-900">{format_date(@author["date_of_birth"])}</dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-sm font-medium text-gray-500">Bio</dt>
      <dd class="mt-1 text-sm text-gray-900">{@author["bio"]}</dd>
    </div>
  </dl>
</div>

<div class="mt-4 flex gap-2">
  <.link
    href={~p"/authors/#{id_to_string(@author["_id"])}/edit"}
    class="bg-amber-500 text-white px-4 py-2 rounded hover:bg-amber-600"
  >Edit</.link>
  <.link
    href={~p"/authors/#{id_to_string(@author["_id"])}"}
    method="delete"
    data-confirm="Are you sure?"
    class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700"
  >Delete</.link>
</div>
