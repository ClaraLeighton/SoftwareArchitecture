<h1 class="text-2xl font-bold mb-4">New Author</h1>

<.link href={~p"/authors"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Authors</.link>

<.form
  for={%{}}
  action={~p"/authors"}
  method="post"
  enctype="multipart/form-data"
  class="space-y-4"
>
  <div>
    <label class="block text-sm font-medium text-gray-700">Name</label>
    <input
      type="text"
      name="author[name]"
      required
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Photo</label>
    <input
      type="file"
      name="author[image]"
      accept="image/*"
      class="mt-1 block w-full text-sm text-gray-700 file:mr-4 file:rounded file:border-0 file:bg-purple-50 file:py-2 file:px-4 file:text-purple-700"
    />
    <p class="mt-1 text-xs text-gray-500">
      Optional. Stored in shared storage and served by the edge.
    </p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
    <input
      type="date"
      name="author[date_of_birth]"
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Country</label>
    <input
      type="text"
      name="author[country]"
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Bio</label>
    <textarea
      name="author[bio]"
      rows="3"
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    ></textarea>
  </div>
  <div>
    <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">Create Author</button>
  </div>
</.form>
