<h1 class="text-2xl font-bold mb-4">Top 10 Rated Books</h1>

<.link href={~p"/books"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Books</.link>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          #
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Title
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Avg Score
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Reviews
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Highest
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Lowest
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <%= for {book, index} <- Enum.with_index(@books, 1) do %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{index}</td>
          <td class="px-6 py-4 whitespace-nowrap">
            <.link
              href={~p"/books/#{id_to_string(book["_id"])}"}
              class="text-indigo-600 hover:text-indigo-900"
            >
              {book["title"]}
            </.link>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <span class="text-yellow-500">{score_stars(round(book["avg"] || 0))}</span>
            <span class="ml-2">{book["avg"] && Float.round(book["avg"] * 1.0, 2)}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {book["reviews"]}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <span class="text-yellow-500">{book["highest"]}★</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <span class="text-yellow-500">{book["lowest"]}★</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= if @books == [] do %>
  <p class="text-gray-500 text-center py-8">No books with enough reviews found.</p>
<% end %>
