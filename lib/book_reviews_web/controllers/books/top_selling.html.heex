<h1 class="text-2xl font-bold mb-4">Top 50 Selling Books</h1>

<.link href={~p"/books"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Books</.link>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          #
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Title
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Book Sales
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Author Total Sales
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Top 5 in Year
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <%= for {book, index} <- Enum.with_index(@books, 1) do %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{index}</td>
          <td class="px-6 py-4 whitespace-nowrap">
            <.link
              href={~p"/books/#{id_to_string(book["bookId"])}"}
              class="text-indigo-600 hover:text-indigo-900"
            >
              {book["title"]}
            </.link>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {format_number(book["totalSales"])}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {format_number(book["authorTotalSales"])}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm">
            <%= if book["inTop5Year"] do %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Yes
              </span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                No
              </span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= if @books == [] do %>
  <p class="text-gray-500 text-center py-8">No books found.</p>
<% end %>
