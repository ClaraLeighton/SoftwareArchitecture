<h1 class="text-2xl font-bold mb-4">Books</h1>

<.link
  href={~p"/books/new"}
  class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 mb-4 inline-block"
>
  New Book
</.link>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Title
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Published
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Sales
        </th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
          Actions
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <%= for book <- @books do %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap">
            <.link
              href={~p"/books/#{id_to_string(book["_id"])}"}
              class="text-indigo-600 hover:text-indigo-900"
            >
              {book["title"]}
            </.link>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {format_date(book["published_date"])}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            {format_number(book["sales"])}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <.link
              href={~p"/books/#{id_to_string(book["_id"])}"}
              class="text-indigo-600 hover:text-indigo-900 mr-3"
            >Show</.link>
            <.link
              href={~p"/books/#{id_to_string(book["_id"])}/edit"}
              class="text-amber-600 hover:text-amber-900 mr-3"
            >Edit</.link>
            <.link
              href={~p"/books/#{id_to_string(book["_id"])}"}
              method="delete"
              data-confirm="Are you sure?"
              class="text-red-600 hover:text-red-900"
            >Delete</.link>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
