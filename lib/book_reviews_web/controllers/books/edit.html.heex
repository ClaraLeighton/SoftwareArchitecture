<h1 class="text-2xl font-bold mb-4">Edit Book</h1>

<.link href={~p"/books"} class="text-indigo-600 hover:text-indigo-900 mb-4 inline-block">← Back to Books</.link>

<.form for={%{}} action={~p"/books/#{id_to_string(@book["_id"])}"} method="post" class="space-y-4">
  <input type="hidden" name="_method" value="put" />
  <div>
    <label class="block text-sm font-medium text-gray-700">Title</label>
    <input
      type="text"
      name="book[title]"
      value={@book["title"]}
      required
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Summary</label>
    <textarea
      name="book[summary]"
      rows="3"
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    ><%= @book["summary"] %></textarea>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Published Date</label>
    <input
      type="date"
      name="book[published_date]"
      value={format_date(@book["published_date"])}
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Total Sales</label>
    <input
      type="number"
      name="book[sales]"
      value={@book["sales"]}
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    />
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Author</label>
    <select
      name="book[author_id]"
      required
      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
    >
      <option value="">Select an author</option>
      <%= for author <- @authors do %>
        <option
          value={id_to_string(author["_id"])}
          selected={id_to_string(author["_id"]) == id_to_string(@book["author_id"])}
        >
          {author["name"]}
        </option>
      <% end %>
    </select>
  </div>
  <div>
    <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">Update Book</button>
  </div>
</.form>
